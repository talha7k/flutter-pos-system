{
  "cSpell.words": [
    "autofocus",
    "avator",
    "crashlytics",
    "cupertino",
    "firestore",
    "Formattable",
    "fullscreen",
    "googleapis",
    "Imageable",
    "Ingr",
    "Linkify",
    "loadmore",
    "LTRB",
    "mockito",
    "possystem",
    "pubspec",
    "reloadable",
    "reorderable",
    "sembast",
    "signin",
    "sqflite",
    "sublist",
    "syncfusion",
    "unfocus",
    "upgrader",
    "vsync",
    "wakelock",
    "xfile"
  ],
  "files.associations": {
    "*.arb": "json"
  },
  "yaml.schemas": {
    ".vscode/arb.schema.json": [
      "/assets/l10n/**/*.yaml"
    ]
  },
  "task.allowAutomaticTasks": true,
  "debug.openDebug": "neverOpen",
  "terminal.integrated.inheritEnv": false,
  "tasks": {
    "label": "lint on open",
    "type": "shell",
    "command": "npm run lint",
    "runOn": "folderOpen"
  }
}
